{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "scripts/**",
    "unused/**",
    "dist/**",
    "public/**",
    ".github/**",
    ".agent/**",
    ".vscode/**",
    ".cursor/**",
    "docs/**",
    "src/lib/seo.ts",
    "src/content/articles/**"
  ],
  "workspaces": {
    "default": {
      "project": [
        "./src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@typescript/native"
      ]
    }
  }
}
